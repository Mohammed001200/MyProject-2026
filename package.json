{
  "name": "civora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "auth:schema": "auth generate --config src/server/auth/schema.ts --adapter prisma --dialect postgresql --output prisma/better-auth.generated.prisma -y",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "eslint . --max-warnings=0 && tsc --noEmit && vitest run && next build"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.2",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.38.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "auth": "1.7.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "tsx": "^4.23.13",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.24.0"
}
