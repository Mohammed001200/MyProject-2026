# Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
CIVORA_DEMO_MODE=true

# PostgreSQL (required when the persisted workspace milestone is enabled)
DATABASE_URL=

# Authentication (generate a strong secret locally; never commit its value)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# AI provider (required only for real document analysis / CIVORA AI)
OPENAI_API_KEY=
OPENAI_MODEL=

# Private object storage (production adapter; local development adapter comes first)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Billing (not active in the current milestone)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_PRICE_ID=
