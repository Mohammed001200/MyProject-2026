# Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
CIVORA_DEMO_MODE=true

# PostgreSQL (required when the persisted workspace milestone is enabled)
DATABASE_URL=

# Authentication (generate a strong secret locally; never commit its value)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# AI provider (required only for real document analysis / CIVORA AI)
OPENAI_API_KEY=
OPENAI_MODEL=
CIVORA_AI_DRIVER=openai

# Durable job runner (32+ random characters; scheduler sends it as Bearer token)
CIVORA_JOB_SECRET=

# Private object storage (local is allowed only in development or explicit CI E2E)
CIVORA_STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=.civora-data

# Production S3-compatible storage (omit both keys to use the AWS default credential chain)
# The private bucket must never have enabled versioning; runtime credentials need s3:GetBucketVersioning.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=

# Billing (not active in the current milestone)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_PRICE_ID=
